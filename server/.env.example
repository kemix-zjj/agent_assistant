# 复制为 .env 后按本地环境修改；.env 不入库
APP_NAME=数智助理 · 助理团
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# MySQL 8.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=assistant
DB_ECHO=false

# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 头像对外访问域名；留空返回后端本地 /static 相对路径
# AVATAR_BASE_URL=https://cdn.example.com
